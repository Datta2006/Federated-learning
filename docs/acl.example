# Federated PM2.5 broker ACL (strict profile, Stage 3 enabled).
# Copy to /tmp/fedpm25-mosquitto/acl and chmod 600.
#
# Each training node (node1-node4) may PUBLISH only under its own
# aq/<node_id>/# tree, its own Stage 3 update subtree
# aq/fl/round/+/update/<node_id>/#, and READ the federated global tree aq/fl/#.
# node5 is the inference-only phone: it may publish status/health/predictions
# under aq/node5/# but has no weight-update write permission.
# The server may read/write everything.

user flserver
topic readwrite #
topic read $SYS/#

user node1
topic write aq/node1/#
topic write aq/fl/round/+/update/node1/#
topic read aq/fl/#

user node2
topic write aq/node2/#
topic write aq/fl/round/+/update/node2/#
topic read aq/fl/#

user node3
topic write aq/node3/#
topic write aq/fl/round/+/update/node3/#
topic read aq/fl/#

user node4
topic write aq/node4/#
topic write aq/fl/round/+/update/node4/#
topic read aq/fl/#

# Inference-only phone: status/health/prediction only, never weight updates.
user node5
topic write aq/node5/#
topic read aq/fl/#

# ---------------------------------------------------------------------------
# Read topics for later stages (uncomment when those stages land)
# ---------------------------------------------------------------------------
# topic read aq/node1/cmd
# topic read aq/alerts/#
